# Build output (root only -- internal/build/ is source code)
/build/

# Scratch space for long-running builds: TMP/TEMP/GOTMPDIR point here when a
# tool runs bash non-interactively (they are empty in that environment and Go
# then tries to build under C:\Windows), so it fills with ~165 MB of go-build
# directories.  Nothing here is a source file.
/.tmp/

# Compiled artifacts
/*.img
*.o
*.elf
*.log
*.pdb

# The tos CLI binary at the repo root (cmd/tos/ is source)
/tos
/tos.exe
/tostest.exe

# Python bytecode from the test scripts
__pycache__/
*.pyc

# Local agent workspace notes (not part of the project)
/.workbuddy/

# Reference source, not vendored: Zephyr is a separate (nested) git repo kept
# only to read from.  It is ~15 MB of sparse checkout and must never be
# committed into TinyOS.  See docs/ZEPHYR-REFERENCE.md for how to fetch it.
/third_party/zephyr/
