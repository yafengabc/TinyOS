# Shell scripts are run by bash, and core.autocrlf=true would otherwise hand
# them a CRLF shebang that fails with "bad interpreter".  Everything else can
# stay on whatever the checkout gives it.
*.sh text eol=lf

# Same reasoning for the ESP32-C3 probes: clang assembles the .S files directly
# and the .py helpers carry a shebang.  A CRLF inside a .S would be a syntax
# error at the end of every line, and the linker scripts would pick up stray
# bytes in their section lists.
*.S   text eol=lf
*.ld  text eol=lf
*.py  text eol=lf
